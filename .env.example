# Copy to your host's environment settings — never commit a filled-in version.
# The website itself never sees these; only the proxy in backend/ does.

# Chat assistant (required for the widget to reply)
GEMINI_API_KEY=your-key-from-aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# Contact form (required for /contact to deliver; free key from web3forms.com)
WEB3FORMS_KEY=your-web3forms-access-key

# Comma-separated origins allowed to call the proxy. Enforced server-side:
# unset means anyone can call it and spend your quota.
ALLOWED_ORIGIN=https://www.azsco.systems,https://azsco.systems
